# Copy to .env. Never commit .env.

# OpenAI-compatible endpoint. In the lab: LiteLLM on ubuntu-home.
CURATOR_LLM_BASE_URL=http://127.0.0.1:4000/v1
# The curator's own LiteLLM virtual key, so its spend shows separately.
CURATOR_LLM_API_KEY=
CURATOR_LLM_MODEL=local-qwen
# Embedding model for same-story grouping, through the same endpoint.
CURATOR_EMBED_MODEL=local-embed
# Seconds per scoring request.
CURATOR_LLM_TIMEOUT=300

CURATOR_LOG_LEVEL=INFO

# Host paths mounted into the container (defaults: ./data and ./config).
# CURATOR_DATA_PATH=/srv/content-curator/data
# CURATOR_CONFIG_PATH=/srv/content-curator/config
# Run as this host user so files in data/ are owned by it.
# CURATOR_UID=1000
# CURATOR_GID=1000

# Phase 1b
# READWISE_TOKEN=

# HTTP API of `curator serve`. Loopback by default; Hermes calls it on the same host.
CURATOR_API_HOST=127.0.0.1
CURATOR_API_PORT=8090
# Bearer token for POST endpoints (trigger jobs, add URLs). Empty = no auth.
CURATOR_API_TOKEN=
